# Set these as process environment variables or a systemd EnvironmentFile.
# Python does NOT load .env files automatically.
HOST=127.0.0.1
PORT=8000
TALENT_DB=data/talents.sqlite3
# Public deployment: HTTPS reverse proxy, then COOKIE_SECURE=1.
COOKIE_SECURE=0
APP_URL=https://your-domain.example
# Keep empty until you configure a real sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Enable only after SMTP delivery is working.
REQUIRE_EMAIL_VERIFICATION=0
